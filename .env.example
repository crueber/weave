# Copy to .env and edit.
# Required: a stable secret (openssl rand -hex 32) and your OIDC client. Weave has no local accounts.
WEAVE_SECRET_KEY=
WEAVE_BASE_URL=http://localhost:8080
WEAVE_PORT=8080

# OIDC (REQUIRED). Redirect URI to register at the IdP: ${WEAVE_BASE_URL}/auth/oidc/callback
# The IdP must expose a `groups` claim (scope `groups`); see README "Identity provider setup".
#   groups: weave-admins, weave-project-owners, weave-users, weave-workers, weave-guests, weave-team-<name>
WEAVE_OIDC_ISSUER=
WEAVE_OIDC_CLIENT_ID=
WEAVE_OIDC_CLIENT_SECRET=
# Optional OIDC tuning (defaults shown)
# WEAVE_OIDC_GROUPS_CLAIM=groups
# WEAVE_OIDC_ADMIN_GROUP=weave-admins
# WEAVE_OIDC_OWNER_GROUP=weave-project-owners
# WEAVE_OIDC_USER_GROUP=weave-users
# WEAVE_OIDC_WORKER_GROUP=weave-workers
# WEAVE_OIDC_GUEST_GROUP=weave-guests
# WEAVE_OIDC_TEAM_PREFIX=weave-team-
# WEAVE_OIDC_REQUIRE_GROUP=false      # true: deny sign-in unless in a role group

# Behind a reverse proxy? set true to trust X-Forwarded-* headers
WEAVE_TRUST_PROXY=false
# WEAVE_SESSION_HOURS=24            # session lifetime (default 24 h; also editable in Admin > Configuration; on expiry users re-authenticate via OIDC)
# WEAVE_SESSION_MAX_IDLE_MINUTES=0   # instance-wide idle bound; 0 = none (also editable in Admin > Configuration)
# WEAVE_HSTS=off                     # HSTS is sent only when WEAVE_BASE_URL is https; off disables it
# WEAVE_HSTS_MAX_AGE=15552000        # seconds (180 days)

# SMTP (optional; can also be set in the admin UI, env wins)
WEAVE_SMTP_HOST=
WEAVE_SMTP_PORT=587
WEAVE_SMTP_USER=
WEAVE_SMTP_PASSWORD=
WEAVE_SMTP_FROM=
